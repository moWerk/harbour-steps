 }
 
+void StepCounterPlugin::armMidnightTimer()
+{
+    // Timers do not run in suspend; a wake after midnight is caught by timeUpdate().
+    QDateTime next(QDate::currentDate().addDays(1), QTime(0, 0, 1));
+    midnightTimer->start(QDateTime::currentDateTime().msecsTo(next));
+}
+
+void StepCounterPlugin::midnight()
+{
+    qDebug() << "midnight: closing the day";
+    triggerRecording();
+    armMidnightTimer();
+}
+
 void StepCounterPlugin::timeUpdate()
 {
     QDateTime currDateTime = QDateTime::currentDateTime();
     uint elapsed = currDateTime.toMSecsSinceEpoch() - lastRecordTime.toMSecsSinceEpoch();
     qDebug() << "time until next steps recording" << recordIntervalTimer->remainingTime() << " elapsed = " << elapsed << " lastRecordTime " << lastRecordTime.toMSecsSinceEpoch();
-    if (elapsed > interval) { // if too much time has passed, reset the timer and record
+    if (lastRecordTime.date() != QDate::currentDate()) { // woke up on a new day: close the old one now
+        triggerRecording();
+        armMidnightTimer();
+    } else if (elapsed > interval) { // if too much time has passed, reset the timer and record
         triggerRecording();
     } else { // otherwise, restart the timer and compensate for time spent in suspend
         recordIntervalTimer->start(interval - elapsed);
