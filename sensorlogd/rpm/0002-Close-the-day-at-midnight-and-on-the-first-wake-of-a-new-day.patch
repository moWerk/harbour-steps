+    // The day changes at 00:00, not at the next interval recording: without this the
+    // live total (sensor minus offset) carries yesterday's steps into the new day until
+    // the next record, up to the whole interval.
+    midnightTimer = new QTimer(this);
+    midnightTimer->setSingleShot(true);
+    connect(midnightTimer, SIGNAL(timeout()), this, SLOT(midnight()));
+    armMidnightTimer();
